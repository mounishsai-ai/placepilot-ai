# App
APP_NAME="AI Campus Placement Agent"
APP_ENV=development
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/placement_db
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/placement_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=models/embedding-001

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db

# SendGrid (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=placement@college.edu
FROM_NAME=Placement Cell

# Twilio (SMS + WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Google Calendar
GOOGLE_CALENDAR_CREDENTIALS_FILE=./credentials/google_calendar.json
GOOGLE_CALENDAR_ID=primary

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
