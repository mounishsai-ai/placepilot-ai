# ─── Required ────────────────────────────────────────────────────────────────
# Fill these three in and the app runs. Everything below them is optional.

# Any PostgreSQL 14+ database. Both URLs point at the same database — the app
# is async (asyncpg), the seed script is sync (psycopg2).
# A free Neon/Supabase database works; append ?sslmode=require for a hosted one.
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/placement_db
SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/placement_db

# From https://aistudio.google.com/apikey — free tier, no billing account.
# This alone powers the agent loop, embeddings and every one-shot agent.
GEMINI_API_KEY=

# Signs JWTs. Any long random string; change it before exposing this anywhere.
SECRET_KEY=change-me-to-something-random

# ─── Optional: Vertex AI instead of the API key ──────────────────────────────
# Only if you have a GCP project with Vertex enabled and ADC available
# (`gcloud auth application-default login`). Vertex has no daily request cap;
# the API key's free tier does. Leave GCP_PROJECT_ID empty to stay on the key.
#
#   auto      use Vertex when a project AND credentials are both present (default)
#   aistudio  always use GEMINI_API_KEY
#   vertex    always use Vertex
LLM_BACKEND=auto
GCP_PROJECT_ID=
VERTEX_EMBEDDING_LOCATION=us-central1

# ─── Optional: models ────────────────────────────────────────────────────────
# The two orchestrator models are NOT interchangeable. gemini-2.5-flash is
# retired on the API-key endpoint and 404s for keys issued after its cutoff,
# so each backend names its own.
VERTEX_ORCHESTRATOR_MODEL=gemini-2.5-flash
AISTUDIO_ORCHESTRATOR_MODEL=gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_PRO=gemini-3.5-flash
EMBEDDING_MODEL=gemini-embedding-001

# ─── Optional: real notification delivery ────────────────────────────────────
# Without these, notifications are still created and shown in the UI — sending
# just fails and is logged. Nothing else breaks.
SENDGRID_API_KEY=
FROM_EMAIL=placement@college.edu
FROM_NAME=Placement Cell

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# ─── Optional: local paths and app config ────────────────────────────────────
APP_NAME="PlacePilot AI"
APP_ENV=development
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_URL=http://localhost:3000
CHROMA_PERSIST_DIR=./chroma_db

# Resume uploads. Container filesystems are ephemeral — see the README's
# limitations section.
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
