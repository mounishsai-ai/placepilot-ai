# Verified working Vertex AI model IDs (tested live via curl on 2026-08-26):
#   Chat/generation models -> call on the GLOBAL endpoint:
#     https://aiplatform.googleapis.com/v1/projects/{PROJECT}/locations/global/publishers/google/models/{MODEL}:generateContent
#     Working: gemini-3.5-flash, gemini-2.5-flash, gemini-2.5-pro, gemini-3-flash-preview, gemini-flash-latest
#     NOT found: gemini-3-flash, gemini-3-pro, gemini-3-pro-preview, gemini-2.0-flash-001 (all 404 on this project)
#
#   Embedding model -> call on the REGIONAL endpoint (us-central1), :predict not :generateContent:
#     https://us-central1-aiplatform.googleapis.com/v1/projects/{PROJECT}/locations/us-central1/publishers/google/models/gemini-embedding-001:predict
#     Working: gemini-embedding-001
#     NOT found: gemini-embedding-001 on the `global` endpoint (must be regional)

VERTEX_CHAT_MODEL_FLASH=gemini-3.5-flash
VERTEX_CHAT_MODEL_PRO=gemini-2.5-pro
VERTEX_CHAT_MODEL_PREVIEW=gemini-3-flash-preview
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
VERTEX_CHAT_ENDPOINT_LOCATION=global
VERTEX_EMBEDDING_ENDPOINT_LOCATION=us-central1

