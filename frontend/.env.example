# Copy to .env.local and adjust if your backend is not on port 8000.
#
# IMPORTANT: Next.js inlines NEXT_PUBLIC_* at BUILD time, not runtime. A
# production build made without these ships a frontend that cannot reach the
# API, and no runtime environment variable will fix it.
#
# The backend's CORS allowlist (backend/app/main.py) is a fixed list, so run
# the dev server on port 3000 or 3001.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
